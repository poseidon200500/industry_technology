# Обязательные для docker-compose
HTTP_PORT=8080

# Для Postgres
POSTGRES_HOST=postgres  # имя сервиса в docker-compose
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=123
POSTGRES_DB=balance_db

# Для приложения
PG_URL=postgres://admin:123@postgres:5432/balance_db
PG_URL_LOCALHOST=postgres://admin:123@localhost:5432/balance_db
JWT_SIGN_KEY=123456789123456789123456789123465789
HASHER_SALT=qwerty
GOOGLE_DRIVE_JSON_FILE_PATH=
#GOOGLE_DRIVE_JSON_FILE_PATH=secrets/credentials.json
